# Browser-safe values. These are exposed to the KUT client at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical deployment URL, without a trailing slash.
APP_URL=http://localhost:3000

# Server/CI only. Never prefix this with PUBLIC_, commit it, or send it to a
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap-only operator secrets. They may remain in `.env.local`, but runtime
# scripts never read them; import them explicitly into the Windows DPAPI store.
KUT_BACKUP_PASSPHRASE=
# KUT_SUPABASE_DB_PASSWORD is also accepted here for operator files that
# predate this name. Set one or the other, not both.
KUT_HOSTED_DB_PASSWORD=
