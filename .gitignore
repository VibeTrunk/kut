# Secrets — NEVER commit these. This repo is public; a leaked token is live.
.env*
!.env.example

# Defense-in-depth for future Supabase/service-account key files
*.pem
*.key
*.pfx
*.p12
credentials.json
service-account*.json

# Machine-specific Claude Code settings (yours only, not shared with the repo)
.claude/settings.local.json

# dependencies
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Vercel CLI link artifacts — machine-specific project linkage, not portable between clones
.vercel

# Supabase CLI local state — only relevant if this repo has a supabase/ dir
supabase/.temp

# Encrypted operator backups contain private production data and stay local.
.private-backups/

# Supabase Studio SQL Editor snippets can contain real production data
# (user IDs, role grants, etc.) — never commit them.
supabase/snippets/

# Claude Design canvas: the seeded editor payload is a ~3 MB generated artifact.
# The artboard sources (design/*.dc.html, design/canvas.json) are kept so the
# docs/design/ PNGs can be regenerated.
design/kut-feature-designs.html

# Design verification renders. These are point-in-time screenshots of a
# build, regenerable from design/*.dc.html and design/features/, and they are
# stale within a week — keep them out of history from here on (ADR-064).
# The committed ones predate this rule and are left alone; rewriting history
# to purge them is not worth it on a repo with open branches.
docs/design/features/*.png
design/features/assets/
